# --- Authentication (required) -------------------------------------------
# Create an OAuth app at https://github.com/settings/developers
# Callback URL: <your-site>/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
# Secret for the GitHub webhook (<site>/api/webhooks/github). Optional.
# GITHUB_WEBHOOK_SECRET=""

# --- Database (production only) ------------------------------------------
# Local development uses SQLite (prisma/dev.db) and needs no database settings.
# For deployment, switch prisma/schema.prisma to PostgreSQL and fill these in.
# Supabase: pooled connection on port 6543, direct connection on port 5432.
# DATABASE_URL="postgresql://postgres:<password>@<host>:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres:<password>@<host>:5432/postgres"

# --- Optional AI review pass ---------------------------------------------
# The deterministic rules run without either key. Setting one adds an AI pass.
# GEMINI_API_KEY=""
# OPENAI_API_KEY=""
# GEMINI_MODEL="gemini-2.0-flash"
# OPENAI_MODEL="gpt-4o-mini"
